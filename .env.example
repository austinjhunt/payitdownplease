# Anthropic API key for AI-generated Venmo memos
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Port to run the server on (default: 3000)
PORT=3000

# Path to SQLite database file (default: ./data/donations.db)
DB_PATH=./data/donations.db

# Admin token for the /admin panel (required to enable admin access)
# Set this to a long random string, e.g.: openssl rand -hex 32
ADMIN_TOKEN=your_secret_admin_token_here
